# ============================================================
# MindFlow Hub — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor (default: 3000)
PORT=3000

# Supabase — URL e chave anon (NÃO use a service_role key!)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui

# Sessão — use uma string aleatória forte de no mínimo 32 caracteres
SESSION_SECRET=coloque-uma-string-aleatoria-muito-longa-aqui

# Ambiente: "development" ou "production"
NODE_ENV=development

# Webhook para disparo de ligações (opcional)
# WEBHOOK_URL=https://call-github.bkpxmb.easypanel.host/webhook
# WEBHOOK_API_KEY=sua-chave-aqui
