# ============================================================
# MindFlow Hub — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor (default: 3000)
PORT=3000

# Supabase — URL e chave anon (NÃO use a service_role key!)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui

# Sessão — use uma string aleatória forte de no mínimo 32 caracteres
SESSION_SECRET=coloque-uma-string-aleatoria-muito-longa-aqui

# URL pública do hub (usada em e-mails de recuperação)
# Ex: https://hub-github.bkpxmb.easypanel.host
APP_URL=http://localhost:3000

# Ambiente: "development" ou "production"
NODE_ENV=development

# Webhook para disparo de ligações (opcional)
# WEBHOOK_URL=https://call-github.bkpxmb.easypanel.host/webhook
# WEBHOOK_API_KEY=sua-chave-aqui

# Dashboard Analytics Backend (hub_backend — Python FastAPI)
# Endpoints de WhatsApp, Agendamentos e analytics consolidado via ETL
DASHBOARD_API_URL=https://hub-backend.bkpxmb.easypanel.host

# Agente Validador de Feedbacks (custo mínimo)
OPENAI_API_KEY=sk-sua-chave-openai-aqui
FEEDBACK_VALIDATOR_MODEL=gpt-5.4-nano

# Envio de e-mail para recuperação de senha (evita limite de 2/hora do SMTP padrão do Supabase)
# Opção 1: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxx
# SMTP_FROM=MindFlow <noreply@mindflow-ia.com>
#
# Opção 2: SMTP próprio (Gmail App Password, Hostinger, Zoho, Brevo, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=seu-email@mindflow-ia.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM=MindFlow <seu-email@mindflow-ia.com>


