  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    table { border-collapse: collapse; width: 100%; font-size: 11pt; }
    th {
      background-color: #1E293B;
      color: #FFFFFF;
      font-weight: bold;
      text-align: left;
      padding: 10px 14px;
      border: 1px solid #0F172A;
      font-size: 11pt;
    }
    td {
      border: 1px solid #CBD5E1;
      padding: 8px 12px;
      color: #1E293B;
    }
    tr:nth-child(even) { background-color: #F8FAFC; }
    tr:hover { background-color: #F1F5F9; }
    .txt { mso-number-format:"\@"; }
    .badge-hot { background-color: #FEF2F2; color: #DC2626; font-weight: bold; padding: 2px 6px; border-radius: 4px; }
    .badge-b2b { background-color: #EFF6FF; color: #2563EB; font-weight: bold; padding: 2px 6px; border-radius: 4px; }
  </style>
</head>
